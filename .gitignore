# dependencies / build
node_modules/
dist/
# BACKSTOP ONLY (#255) — the cause is fixed in wt_bootstrap, which no longer installs at a
# dependency-free root. cckit's root package.json is a published bash CLI with zero dependencies, so
# a lockfile HERE is always a stray artifact (and one the captain's policy floor would hold a PR on).
# Anchored to the repo root: docs-site/pnpm-lock.yaml is the real one and is NOT ignored.
/pnpm-lock.yaml
.astro/
.cache/
.turbo/

# secrets, keys, env — NEVER commit (the secret-guard enforces this too)
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.netrc
.pgpass
*.tfvars
.project-ids.env
*.project-ids*

# cckit runtime + the user's private denylist (the .example is committed, the real one is not)
.cckit/
# effort/task worktrees live here — never commit them (they are separate checkouts)
.claude/worktrees/
privacy-denylist
!privacy-denylist.example

# os / editor
.DS_Store
.DS_Store?
._*
Thumbs.db
*.swp
*.swo
.vercel
.env*

# IDE
.idea/
.vscode/
*.iml
