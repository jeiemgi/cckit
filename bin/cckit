#!/usr/bin/env bash
# cckit — the CLI dispatcher. A thin bash front-end over the git-mechanics bundle (scripts/lib).
# Agent-agnostic: every verb runs from a shell; append --json for machine-readable output.
# Driven entirely from cckit.config.json — no org/repo is hardcoded. See AGENTS.md.
#
# Every verb, its question, a prompt to paste and its usage live in ONE table: lib/core/verbs.tsv
# (read through lib/core/verbs.sh). `cckit help` prints it grouped by question; `cckit commands
# --json` prints it as data; scripts/verbs-test.sh fails when this dispatcher's case labels, the CLI
# reference page, kit/skills/routing.yaml or lib/core/forge-report.sh drift from it.
set -eu

# Resolve this script through symlinks — Homebrew and lib/verbs/install.sh link bin/cckit onto
# PATH, so $0 may be a symlink; follow it to find the real repo root (where scripts/lib lives).
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -h "$SOURCE" ]; do
  _dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$_dir/$SOURCE" ;; esac
done
BIN="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT="$(cd "$BIN/.." && pwd)"
LIB="$ROOT/lib"

# Resolve the PROJECT config from the directory cckit was invoked in (walk upward for
# cckit.config.json, or .claude/kit.config.json), so board/lifecycle verbs act on the project you
# ran cckit in — NOT cckit's own install dir. Running inside the cckit repo resolves to its own
# cckit.config.json naturally (self-hosting); outside any project we fall back to cckit's config.
# An explicit KIT_CONFIG in the environment always wins. The walk lives in the ONE shared resolver
# (config-path.sh, #69) that every kit entrypoint uses.
# shellcheck source=/dev/null
source "$LIB/core/config-path.sh"
_KIT_CONFIG_GIVEN="${KIT_CONFIG:+1}"   # 1 = the caller named a config; init keeps only that one (#487)
if [ -z "${KIT_CONFIG:-}" ]; then
  KIT_CONFIG="$(kit_config_find "$PWD" || true)"
  [ -n "$KIT_CONFIG" ] || KIT_CONFIG="$ROOT/cckit.config.json"
fi
export KIT_CONFIG
# No `cd "$ROOT"`: cckit's own files are referenced via absolute $ROOT/$LIB/$BIN paths, while
# project verbs (sync/start/pr/close/gc/scan/status/effort/…) must run in the invoking directory.
# Verbs that act on cckit itself (release, contribute) cd into $ROOT locally below.

# Structured-output helpers (cckit_is_json / cckit_json) — wired into every verb below.
# shellcheck source=/dev/null
source "$LIB/core/cckit-output.sh"
# Terminal ergonomics (color/tty gating, optional glow/fzf) — detect-or-fallback, never required.
# shellcheck source=/dev/null
source "$LIB/core/ui.sh"

# The verb table (#555): help, the command catalog and completions read it.
# shellcheck source=/dev/null
source "$LIB/core/verbs.sh"
usage() { verbs_help; }

# --json → structured output (parsed by agents). Strip it from positional args, export a flag.
# `--llm` and `--output=json` are older spellings of the same flag and keep working (#588).
CCKIT_OUTPUT="human"
_json_flag=0
args=()
for a in "$@"; do
  case "$a" in
    --llm|--output=json) CCKIT_OUTPUT="json" ;;
    --json) _json_flag=1 ;;
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

# Bare `cckit` (no verb) resumes the last session's handoff (locked behavior).
cmd="${1:-resume}"; shift || true
# The verb name, for a forge refusal that names it (lib/forge/forge.sh forge_need).
export CCKIT_VERB="$cmd"
# The first argument as typed, before an alias adds words in front of it: `cckit sync --help` is help.
_first_arg="${1:-}"

# An old verb name (a `kind=alias` row of lib/core/verbs.tsv) still works (#557): it prints a
# one-line notice on stderr and runs the verb it was renamed to. A target may carry words after the
# verb (`status --board`, `agent lib`, #588); they go in front of the typed arguments. CCKIT_VERB
# keeps the typed name, so a refusal names what the user ran. Aliases are never removed before 1.0.
if _alias_target="$(verbs_alias_target "$cmd")"; then
  verbs_alias_notice "$cmd" "$_alias_target" >&2
  # shellcheck disable=SC2086 # the target's words split on purpose: "status --board" → status, --board
  set -- $_alias_target "$@"
  cmd="$1"; shift
fi

# `--json` is the documented output flag. Three verbs own a `--json` of their own, with another
# shape, and receive it untouched: `commands --json` (the full catalog), `status --board --json`
# (the board as one document) and `bench … --json`. Everywhere else it means CCKIT_OUTPUT=json.
if [ "$_json_flag" = 1 ]; then
  case "$cmd" in
    commands|bench) set -- "$@" --json ;;
    status) case " $* " in *" --board "*) set -- "$@" --json ;; *) CCKIT_OUTPUT="json" ;; esac ;;
    *) CCKIT_OUTPUT="json" ;;
  esac
fi
export CCKIT_OUTPUT

# `cckit <verb> --help` (#556): the dispatcher answers from the verb table before the verb runs, so
# every verb has help and none sees a --help it does not parse. A verb whose table row says
# ownhelp=yes then runs with that --help too, in a child, and its own text follows under "Details:".
# Help always exits 0: some verbs print their usage on --help with rc 2.
case "$_first_arg" in
    -h|--help)
      if [ -z "${_CCKIT_HELP_SHOWN:-}" ] && verbs_entry "$cmd"; then
        [ "$(verbs_get "$cmd" 7)" = yes ] || exit 0
        printf '\nDetails:\n'
        _CCKIT_HELP_SHOWN=1 "$BIN/cckit" "$cmd" --help </dev/null || true
        exit 0
      fi ;;
esac

case "$cmd" in
  version)
    # The installed cckit version is cckit's OWN config, independent of the project we're invoked in.
    v="$(jq -r '.kitVersion // "0.0.0"' "$ROOT/cckit.config.json" 2>/dev/null || echo 0.0.0)"
    if cckit_is_json; then cckit_json version "$v"; else echo "cckit $(ui_paint '1;36' "$v")"; fi
    ;;
  effort)
    # Load the project config FIRST (like every sibling verb): KIT_REPO / KIT_BASE_BRANCH /
    # KIT_PROJECTS_V2 drive repo resolution, the worktree base, and the board guard below —
    # without this, effort start silently branches from origin/main on a non-main-based repo (#151).
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/core/effort.sh"
    # shellcheck source=/dev/null
    source "$LIB/verbs/effort-ops.sh"   # the new|start|pr|close lifecycle ops (compose effort.sh helpers)
    # shellcheck source=/dev/null
    source "$LIB/core/effort-metrics.sh"   # effort_ctx_bucket — sizes the ctx:* label on `effort new`
    sub="${1:-}"; shift || true
    case "$sub" in
      new)
        # Full parity with /kit-effort-new: load the board + role helpers so an effort created via
        # the verb lands on the board exactly as the skill does. Board ops are guarded inside
        # effort_new, so this is a safe no-op when Projects v2 is off or the IDs aren't captured.
        if [ "${KIT_PROJECTS_V2:-}" = "true" ]; then
          # shellcheck source=/dev/null
          source "$LIB/forge/gh-project.sh"; load_project_ids >/dev/null 2>&1 || true
          # shellcheck source=/dev/null
          source "$LIB/core/role-identity.sh" 2>/dev/null || true
        fi
        effort_new "$@" ;;
      sub)
        if [ "${KIT_PROJECTS_V2:-}" = "true" ]; then
          # shellcheck source=/dev/null
          source "$LIB/forge/gh-project.sh"; load_project_ids >/dev/null 2>&1 || true
        fi
        effort_sub "$@" ;;
      retitle) effort_retitle "$@" ;;
      chain) effort_chain "$@" ;;
      start) effort_start "$@" ;;
      pr)
        # role-identity gives the PR its role title, commit trailer and signature; the board
        # helpers load lazily inside effort_pr (_eo_source_board).
        # shellcheck source=/dev/null
        source "$LIB/core/role-identity.sh" 2>/dev/null || true
        effort_pr "$@" ;;
      close) effort_close "$@" ;;
      plan)
        # One planning verb (#585). Bare: the session-fit view of the open efforts. `--issues`: the
        # open issues in dependency waves (was `cckit plan`). `--wave`: the next wave as a fan-out
        # brief plus the captain drive (was `cckit wave` / `copilot`). `--next`: what to build next,
        # from what the kit already does (was `cckit plan-next`). The old names are alias rows.
        case "${1:-}" in
          --issues) shift
            # shellcheck source=/dev/null
            source "$LIB/verbs/plan-machine.sh"; plan_machine "$@" ;;
          --wave) shift
            # shellcheck source=/dev/null
            source "$LIB/verbs/copilot.sh"; copilot_brief "$@" ;;
          --next) shift
            # shellcheck source=/dev/null
            source "$LIB/verbs/plan-next.sh"; plan_next "$@" ;;
          *)
            # shellcheck source=/dev/null
            source "$LIB/verbs/effort-plan.sh"; effort_plan "$@" ;;
        esac ;;
      sprint)
        # One week, Monday to Monday, as a forge milestone (#570). A sub-verb, so the top-level verb
        # count does not grow; `name` and `bounds` run on git alone.
        # shellcheck source=/dev/null
        source "$LIB/verbs/sprint.sh"; sprint_cli "$@" ;;
      review)
        # Each sub against its own `## Spec`, one verdict line per sub (#583). A read.
        # shellcheck source=/dev/null
        source "$LIB/verbs/effort-review.sh"; effort_review "$@" ;;
      *) echo "cckit effort <new|sub|retitle|chain|start|pr|close|plan|sprint|review>" >&2; exit 2 ;;
    esac
    ;;
  start)
    # Isolated worktree + branch for an issue (wt_start drives off cckit.config.json: repo + base
    # branch). Config must be loaded so KIT_REPO / KIT_BASE_BRANCH are set before wt_start runs.
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/core/role-identity.sh"; source "$LIB/core/worktree-start.sh"
    if cckit_is_json; then
      # `&& … ||` keeps `set -e` from exiting on a refused start before the JSON result is printed.
      out="$(wt_start "$@" 2>&1)" && rc=0 || rc=$?
      # The issue is the first non-flag argument: `start --force 42` reports 42, not `--force`.
      start_issue=""; for a in "$@"; do case "$a" in -*) ;; *) start_issue="$a"; break ;; esac; done
      cckit_json verb start issue "$start_issue" ok "$([ "$rc" -eq 0 ] && echo true || echo false)" \
        detail "$(printf '%s' "$out" | tail -1)"
      exit "$rc"
    fi
    wt_start "$@"
    ;;
  pr|close)
    if [ "$cmd" = pr ]; then case "${1:-}" in -h|--help)
      echo 'cckit pr <issue> "<summary>" ["<commit-msg>"] [--base <branch>]'; exit 0 ;; esac; fi
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/core/role-identity.sh"; source "$LIB/forge/gh-project.sh"; source "$LIB/verbs/kit-task-ops.sh"
    if [ "$cmd" = close ]; then case "${1:-}" in -h|--help)
      echo 'cckit close <issue> ["<summary>"] [--reason completed|not-planned|duplicate] [--duplicate-of N] [--superseded-by N]'; exit 0 ;; esac; fi
    if cckit_is_json; then
      case "$cmd" in
        pr)    out="$(kto_task_pr    "$@" 2>&1)"; rc=$? ;;
        close) out="$(kto_task_close "$@" 2>&1)"; rc=$? ;;
      esac
      url="$(printf '%s' "$out" | grep -oE 'https://[^ ]+/pull/[0-9]+' | tail -1)"
      # pr: --base may come before the issue number, so skip it when reporting the issue (#391).
      if [ "$cmd" = pr ]; then
        while [ "$#" -gt 0 ]; do
          case "$1" in --base) shift; [ "$#" -gt 0 ] && shift ;; --base=*) shift ;; *) break ;; esac
        done
      fi
      cckit_json verb "$cmd" issue "${1:-}" ok "$([ "$rc" -eq 0 ] && echo true || echo false)" \
        url "$url" detail "$(printf '%s' "$out" | tail -1)"
      exit "$rc"
    fi
    case "$cmd" in
      pr)    kto_task_pr    "$@" ;;
      close) kto_task_close "$@" ;;
    esac
    ;;
  hotfix)
    # Carry ONE merged change to the release branch (#360): its own PR path, because a cherry-pick
    # has no issue for `cckit pr` to read or close.
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/core/worktree-start.sh"; source "$LIB/verbs/kit-hotfix.sh"
    if cckit_is_json; then
      out="$(kto_hotfix "$@" 2>&1)" && rc=0 || rc=$?
      url="$(printf '%s' "$out" | grep -oE 'https://[^ ]+/pull/[0-9]+' | tail -1)"
      cckit_json verb hotfix source "${1:-}" ok "$([ "$rc" -eq 0 ] && echo true || echo false)" \
        url "$url" worktree "$(printf '%s\n' "$out" | sed -n 's/^worktree: //p' | tail -1)" \
        detail "$(printf '%s' "$out" | tail -1)"
      exit "$rc"
    fi
    kto_hotfix "$@"
    ;;
  new)
    # File ONE issue through kto_task_new (labels + board add + Role/Status fields). This verb is why
    # an agent never needs raw `gh issue create`, which skips the board (#361). Multi-part work is
    # `cckit effort new`. Defaults: kind task, priority p2; role from --role or KIT_DEFAULT_ROLE.
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/core/role-identity.sh"; source "$LIB/forge/gh-project.sh"; source "$LIB/verbs/kit-task-ops.sh"
    n_role="${KIT_DEFAULT_ROLE:-}"; n_kind="task"; n_prio="p2"; n_ms=""; n_plan=""; n_blocked=""; n_body=""; n_title=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --role)       n_role="${2:-}"; shift 2 ;;
        --kind)       n_kind="${2:-}"; shift 2 ;;
        --priority)   n_prio="${2:-}"; shift 2 ;;
        --milestone)  n_ms="${2:-}"; shift 2 ;;
        --plan)       n_plan="${2:-}"; shift 2 ;;
        --blocked-by) n_blocked="${2:-}"; shift 2 ;;
        --body)       n_body="${2:-}"; shift 2 ;;
        --body-file)  n_body="$(cat "${2:-/dev/null}")"; shift 2 ;;
        -h|--help)    echo 'cckit new [--role R --kind K --priority P --milestone M --plan L --blocked-by "#1" --body B|--body-file F] "<title>"'; exit 0 ;;
        --)           shift; n_title="${n_title:+$n_title }$*"; break ;;
        -*)           echo "cckit new: unknown flag $1" >&2; exit 2 ;;
        *)            n_title="${n_title:+$n_title }$1"; shift ;;
      esac
    done
    [ -n "$n_title" ] || { echo 'cckit new: a title is required — cckit new --role R "<title>"' >&2; exit 2; }
    [ -n "$n_role" ]  || { echo 'cckit new: --role is required (or set KIT_DEFAULT_ROLE)' >&2; exit 2; }
    if cckit_is_json; then
      rc=0; out="$(kto_task_new "$n_title" "$n_role" "$n_kind" "$n_prio" "$n_ms" "$n_plan" "$n_blocked" "$n_body" 2>&1)" || rc=$?
      url="$(printf '%s' "$out" | grep -oE 'https://[^ ]+/issues/[0-9]+' | tail -1)"
      cckit_json verb new issue "$(basename "${url:-x}")" ok "$([ "$rc" -eq 0 ] && echo true || echo false)" \
        url "$url" detail "$(printf '%s' "$out" | tail -1)"
      exit "$rc"
    fi
    kto_task_new "$n_title" "$n_role" "$n_kind" "$n_prio" "$n_ms" "$n_plan" "$n_blocked" "$n_body"; echo
    ;;
  task)
    # Light tasks (#450): work tracked through a task source (the `file` source: one tracked file
    # per task) and not through GitHub issues. One dispatcher in the lib, as `qa` and `receipt` do.
    # kit-task-ops.sh is loaded for kto_pr_title only, so the PR title is built by the same code
    # `cckit pr` uses.
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/core/worktree-issue.sh"; source "$LIB/core/worktree-start.sh"
    # shellcheck source=/dev/null
    source "$LIB/core/commitlint.sh"; source "$LIB/verbs/kit-task-ops.sh"
    # shellcheck source=/dev/null
    source "$LIB/verbs/light-task.sh"
    lt_cli "$@"
    ;;
  merge)
    # Merge (squash by default, --merge / --rebase, #376) through kto_task_pr_merge: rebase on conflict, close the PR's linked issues (native
    # auto-close only fires on the default branch), then clean the branch + worktree. The verb behind
    # every raw `gh pr merge` (#361). An effort's PR merges with `cckit effort close <N>`: an
    # effort/* head is refused here (#379; KIT_FORCE=1 overrides).
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/core/role-identity.sh"; source "$LIB/forge/gh-project.sh"; source "$LIB/verbs/kit-task-ops.sh"
    case "${1:-}" in -h|--help) echo 'cckit merge [<pr>] [--squash|--merge|--rebase]   merge (squash by default; rebases on conflict), close linked issues, GC branch + worktree, update the PR base'; exit 0 ;; esac
    kto_task_pr_merge "$@"
    ;;
  cleanup)
    # ONE guided destructive sweep over the gc analysis: plan first, delete only the SAFE rows, and
    # only with --yes. Orphans, protected branches and stashes are surfaced and left alone.
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/verbs/kit-gc.sh"
    if cckit_is_json; then
      # Keep BOTH the exit status and the diagnostic. `|| true` + `2>/dev/null` would turn a refusal
      # (protection helper missing, analysis failed) or a partial run (a remote delete that failed)
      # into `applied: yes` with zero counts and rc 0 — a JSON consumer would read that as a clean
      # sweep. Reporting a wrong success is the failure mode this whole op exists to avoid.
      cleanup_err="$(mktemp)"; cleanup_rc=0
      out="$(kit_gc_cleanup "$@" 2>"$cleanup_err")" || cleanup_rc=$?
      safe="$(printf '%s\n' "$out" | awk '/^  SAFE branches/{print $3}')"
      wt="$(printf '%s\n' "$out" | awk '/^  SAFE worktrees/{print $3}')"
      landed="$(printf '%s\n' "$out" | awk '/^  LANDED branches/{print $3}')"
      orphan="$(printf '%s\n' "$out" | awk '/^  ORPHAN kept/{print $3}')"
      protected="$(printf '%s\n' "$out" | awk '/^  PROTECTED kept/{print $3}')"
      unknown="$(printf '%s\n' "$out" | awk '/^  UNKNOWN kept/{print $3}')"
      stash="$(printf '%s\n' "$out" | awk '/^  stashes kept/{print $3}')"
      zombie="$(printf '%s\n' "$out" | awk '/^  ZOMBIE worktrees/{print $3}')"
      rfail="$(printf '%s\n' "$out" | awk '/^  remote deletes failed/{print $4}')"
      applied=no
      if [ "$cleanup_rc" -eq 0 ]; then case " $* " in *" --yes "*|*" -y "*) applied=yes ;; esac; fi
      err="$(tr '\n' ' ' < "$cleanup_err" | sed 's/[[:space:]]*$//')"; rm -f "$cleanup_err"
      cckit_json verb cleanup safe "${safe:-0}" landed "${landed:-0}" worktrees "${wt:-0}" orphan "${orphan:-0}" \
        protected "${protected:-0}" unknown "${unknown:-0}" stash "${stash:-0}" zombie "${zombie:-0}" applied "$applied" \
        remote_failed "${rfail:-0}" rc "$cleanup_rc" error "$err"
      [ "$cleanup_rc" -eq 0 ] || exit "$cleanup_rc"
    else
      kit_gc_cleanup "$@"
    fi
    ;;
  gc)
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/verbs/kit-gc.sh"
    case " $* " in
      *" --prune "*|*" prune "*)
        # Remove worktrees + local branches whose PR merged (SAFE) or whose work is already on base
        # with no PR of their own (LANDED, #388). Dry-run unless --yes.
        kit_gc_prune "$@"
        ;;
      *)
        if cckit_is_json; then
          out="$(kit_gc_analyze 2>/dev/null || true)"
          safe="$(printf '%s\n' "$out" | grep -c '> SAFE ' || true)"
          landed="$(printf '%s\n' "$out" | grep -c '> LANDED ' || true)"
          protected="$(printf '%s\n' "$out" | grep -c 'PROTECTED:' || true)"
          orphan="$(printf '%s\n' "$out" | grep -c 'ORPHAN' || true)"
          unknown="$(printf '%s\n' "$out" | grep -c '> UNKNOWN ' || true)"
          cckit_json verb gc safe "$safe" landed "$landed" protected "$protected" orphan "$orphan" unknown "$unknown"
        else
          kit_gc_analyze "$@"
        fi
        ;;
    esac
    ;;
  orchestrate) exec "$ROOT/lib/verbs/orchestrate.sh" "$@" ;;
  autopilot)   exec "$ROOT/lib/verbs/autopilot.sh" "$@" ;;
  next)
    # Everyday-dev helper: surface the unblocked set + the one command to start the top issue.
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # tasks.default = light (the marketing profile): a bare `cckit next` answers from the light
    # task list — the same output as `cckit task next`. Any argument (`--effort <N>`, a filter)
    # asks about issues and takes the issue path, as does every project whose default is issues.
    if [ "$#" -eq 0 ]; then
      # shellcheck source=/dev/null
      source "$LIB/core/task-source.sh"
      if [ "$(task_default_name)" = "light" ]; then
        # shellcheck source=/dev/null
        source "$LIB/core/worktree-issue.sh"; source "$LIB/verbs/light-task.sh"
        lt_cli next
        exit $?
      fi
    fi
    # shellcheck source=/dev/null
    source "$LIB/verbs/next.sh"; next_issue "$@"
    ;;
  watch)
    # Captain: gate open PRs, squash-merge the CLEAN ones, advance to the next wave. Runs in the
    # invoking project; needs config so KIT_REPO is set before captain reads it.
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config
    # shellcheck source=/dev/null
    source "$LIB/verbs/captain.sh"
    watch_loop=0; watch_args=()
    for a in "$@"; do case "$a" in --loop) watch_loop=1 ;; *) watch_args+=("$a") ;; esac; done
    if [ "$watch_loop" = "1" ]; then
      captain_loop "${watch_args[@]+"${watch_args[@]}"}"
    else
      captain_pass "${watch_args[@]+"${watch_args[@]}"}"
    fi
    ;;
  # Ops exposed so an agent/autopilot can run the whole lifecycle through the one CLI (#16).
  release)
    # Acts on cckit's own repo, so run from the install root regardless of where it was invoked.
    cd "$ROOT"
    # `--next` reports the version the conventional commits imply; otherwise cut a release.
    case "${1:-}" in
      --next) exec "$ROOT/lib/core/version-bump.sh" --next ;;
      *)      exec "$ROOT/lib/verbs/publish.sh" "$@" ;;
    esac
    ;;
  update)      exec "$ROOT/lib/verbs/kit-version-check.sh" "$@" ;;
  migrate)     exec "$ROOT/lib/verbs/kit-migrate.sh" "$@" ;;
  adopt)       exec "$ROOT/lib/verbs/kit-adopt.sh" "$@" ;;
  doctor)      exec "$ROOT/lib/verbs/kit-doctor.sh" "$@" ;;
  add)         exec "$ROOT/lib/verbs/kit-add.sh" "$@" ;;
  digest)      exec "$ROOT/lib/verbs/kit-digest.sh" "$@" ;;
  bench)
    # Documentation benchmark (#200) — score how well this project finds + uses its OWN canonical
    # docs. Runs the PROJECT's scaffolded harness if present, else cckit's own copy. BENCH_KIT_ROOT
    # lets the runner fall back to the shipped example set before a project grows its own data.
    BENCH_ROOT="$PWD/scripts/benchmark"; [ -d "$BENCH_ROOT" ] || BENCH_ROOT="$ROOT/scripts/benchmark"
    export BENCH_KIT_ROOT="$ROOT"
    sub="${1:-report}"; shift || true
    BENCH_USAGE='cckit bench <run|quality|report|gate|stop-check> [--dry] [--json]
cckit bench checkpoint <X.Y.Z> [--passes N] [--from <run.json>] [--model <name>] [--note <text>] [--verbs <timings.json>]
cckit bench checkpoints [--json] | check <X.Y.Z> | page [--out <file>] [--check]
cckit bench verbs [--runs N] [--checkout <dir>] [--verb "<verb>"] [--json]   (attach: checkpoint <X.Y.Z> --verbs <file>)'
    case "$sub" in
      run)        exec bash "$BENCH_ROOT/run.sh" "$@" ;;
      quality)    exec bash "$BENCH_ROOT/run-quality.sh" "$@" ;;
      report)     exec bash "$BENCH_ROOT/report.sh" "$@" ;;
      gate)       exec bash "$BENCH_ROOT/gate.sh" "$@" ;;
      stop-check) exec bash "$BENCH_ROOT/stop-check.sh" "$@" ;;
      # Recorded checkpoints per release version (#452). A project scaffolded before checkpoint.sh
      # existed has no copy of it, so these fall back to cckit's own.
      checkpoint|checkpoints|check|page)
        CP="$BENCH_ROOT/checkpoint.sh"; [ -f "$CP" ] || CP="$ROOT/scripts/benchmark/checkpoint.sh"
        case "$sub" in
          checkpoint)  exec bash "$CP" record "$@" ;;
          checkpoints) exec bash "$CP" list "$@" ;;
          *)           exec bash "$CP" "$sub" "$@" ;;
        esac ;;
      # Wall time + gh call count of the read-only verbs (#452). Same fallback as the checkpoint verbs.
      verbs)
        VT="$BENCH_ROOT/verb-timings.sh"; [ -f "$VT" ] || VT="$ROOT/scripts/benchmark/verb-timings.sh"
        exec bash "$VT" "$@" ;;
      -h|--help)  echo "$BENCH_USAGE"; exit 0 ;;
      *) echo "$BENCH_USAGE" >&2; exit 2 ;;
    esac
    ;;
  scan)        source "$LIB/core/project-scan.sh"; project_scan "$@" ;;
  debug)       exec "$ROOT/lib/verbs/debug.sh" "$@" ;;
  contribute)
    # The cckit checkout containing cwd (a worktree, per the rules) wins over the installed one, so
    # the gate runs on — and the PR opens from — the branch being worked on (#368).
    # shellcheck source=/dev/null
    source "$LIB/verbs/contribute-root.sh"
    croot="$(contribute_root "$PWD" "$ROOT")"
    [ "$croot" = "$ROOT" ] || echo "contribute: using the checkout at $croot" >&2
    cd "$croot"; exec "$croot/scripts/contribute.sh" "$@" ;;
  status)
    # `--board` is the board view by role, what `cckit sync` printed before it folded in here (#588);
    # every other form is the "where are we?" dashboard.
    case " $* " in
      *" --board "*)
        board_args=(); for a in "$@"; do [ "$a" = --board ] || board_args+=("$a"); done
        exec "$ROOT/lib/verbs/task-sync.sh" "${board_args[@]+"${board_args[@]}"}" ;;
    esac
    exec "$ROOT/lib/verbs/status.sh" "$@" ;;
  claims)
    # Live session claims (#384) — which session is working which issue. Read-only: a dead claim is
    # skipped here and reaped by the next `cckit start` on that issue, never by this verb.
    # shellcheck source=/dev/null
    source "$LIB/core/session-registry.sh"
    if cckit_is_json; then sreg_list "$PWD" --json; exit 0; fi
    rows="$(sreg_list "$PWD")"
    if [ -z "$rows" ]; then echo "(no live claims)"; exit 0; fi
    printf '%-7s %-8s %-17s %-42s %s\n' "ISSUE" "PID" "SINCE" "BRANCH" "WORKTREE"
    printf '%s\n' "$rows" | while IFS=$'\t' read -r c_issue c_branch c_wt c_pid c_host c_started; do
      c_since="$(date -r "$c_started" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$c_started" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$c_started")"
      printf '%-7s %-8s %-17s %-42s %s\n' "#$c_issue" "$c_pid" "$c_since" "$c_branch" "$c_wt"
    done
    ;;
  resume)      source "$LIB/verbs/handoff.sh"; handoff_read ;;
  handoff)     source "$LIB/verbs/handoff.sh"; handoff_write "$@" ;;
  install)     exec "$ROOT/lib/verbs/install.sh" "$@" ;;
  init)
    # init resolves the config from the folder it sets up. The KIT_CONFIG this dispatcher worked out
    # is the invoking directory's project or, outside any project, cckit's OWN config: read as the
    # new project's, that one gave every fresh project cckit's base branch and label set (#487).
    # A KIT_CONFIG the caller exported is kept.
    [ -n "$_KIT_CONFIG_GIVEN" ] || unset KIT_CONFIG
    exec "$ROOT/lib/verbs/init.sh" "$@" ;;
  commands)
    # The command catalog, read from lib/core/verbs.tsv. `--json`: every verb, default and alias
    # as an object (name, kind, target, group, needs, skill, question, prompt, usage). `--llm` keeps
    # its old shape, a JSON array of names. Human: the names, space-separated (completions read it).
    case " $* " in *" --json "*) verbs_json; exit 0 ;; esac
    verbs="$(verbs_names | sort -u)"
    if cckit_is_json; then printf '%s\n' "$verbs" | jq -R . | jq -cs .; else printf '%s\n' "$verbs" | tr '\n' ' '; echo; fi
    ;;
  brief)
    # The delegation BRIEF for an issue, generated from real state (#221). The companion to `lib`:
    # `lib` says what helpers exist, this says which of them THIS issue's files sit on, where the
    # work happens, and whether the branch's seed is stale. Reads the issue via gh; every other
    # section degrades to an explicit line rather than going quietly missing.
    # shellcheck source=/dev/null
    source "$LIB/core/kit-config.sh" && load_kit_config 2>/dev/null || true
    # shellcheck source=/dev/null
    source "$LIB/core/worktree-issue.sh" 2>/dev/null || true
    # shellcheck source=/dev/null
    source "$LIB/verbs/kit-lib.sh"
    # shellcheck source=/dev/null
    source "$LIB/verbs/kit-brief.sh"
    CCKIT_ROOT="$ROOT" kit_brief "$@"
    ;;

  agent)
    # The plumbing agents call and people rarely type (#588): each was a top-level verb and keeps
    # its old name as an alias row of lib/core/verbs.tsv.
    sub="${1:-}"; shift || true
    case "$sub" in
      lib)
        # The HELPER catalog — the companion to `commands` (#222). `commands` lists the verbs; this
        # lists the library they are built from, so a helper like pr-evidence.sh is discoverable
        # without an `ls`. Filesystem-only; config is loaded purely for the project-root inference
        # (KIT_CONFIG), then it catalogs that project's scripts/lib, else cckit's own.
        # shellcheck source=/dev/null
        source "$LIB/core/kit-config.sh" && load_kit_config 2>/dev/null || true
        # shellcheck source=/dev/null
        source "$LIB/verbs/kit-lib.sh"; kit_lib "$@"
        ;;
      receipt)
        # One durable record per stage attempt (#322). The WORKER calls this itself: cckit never
        # reads pane output, because #326 requires that pane history — off by default, and able to
        # hold secrets — is never a dependency. The report arrives on stdin in the shape `cckit
        # brief`'s receipt contract asked for, so the prompt and this parser cannot drift apart.
        # shellcheck source=/dev/null
        source "$LIB/core/stage-receipt.sh"
        sr_cli "$@"
        ;;
      msg)
        # Session mail (#175) — pure git-local state (.cckit/mail at the root worktree), no config.
        source "$LIB/verbs/kit-msg.sh"
        msub="${1:-}"; shift || true
        case "$msub" in
          send)       msg_send "$@" ;;
          read)       msg_read "$@" ;;
          list)       msg_list ;;
          hook-check) msg_hook_check "$@" ;;
          *) echo 'cckit agent msg <send|read|list|hook-check>' >&2; exit 2 ;;
        esac
        ;;
      encode-context) source "$LIB/core/toon.sh"; toon_encode ;;
      render)         source "$LIB/core/render.sh"; cckit_render ;;
      *) echo 'cckit agent <lib|receipt|msg|encode-context|render>' >&2; exit 2 ;;
    esac
    ;;
  qa)
    # The QA lane (#295): launch the stack command the project declared under `qa`, on this lane's
    # port block, and report USABLE only when every readiness probe answers. One dispatcher in the
    # lib, as `receipt` does with sr_cli, so later subcommands land there and not here.
    # shellcheck source=/dev/null
    source "$LIB/core/qa-lane.sh"
    qa_cli "$@"
    ;;
  page)
    # Review pages (#451): a plan, a decision or a grilling round opens as a page when this session
    # has a browser, and prints to the terminal when it does not. One dispatcher in the lib.
    # shellcheck source=/dev/null
    source "$LIB/verbs/review-page.sh"
    rp_cli "$@"
    ;;
  completions)
    case "${1:-bash}" in
      bash) cat "$ROOT/kit/completions/cckit.bash" ;;
      zsh)  echo "autoload -Uz bashcompinit && bashcompinit"; cat "$ROOT/kit/completions/cckit.bash" ;;
      *)    echo "cckit completions [bash|zsh]" >&2; exit 2 ;;
    esac
    ;;
  help|--help|-h)
    # `cckit help <verb>` is `cckit <verb> --help`.
    if [ -n "${1:-}" ]; then
      verbs_get "$1" 2 >/dev/null || { echo "cckit help: no verb '$1' — run 'cckit help'" >&2; exit 2; }
      exec "$BIN/cckit" "$1" --help
    fi
    usage ;;
  *) echo "cckit: unknown command '$cmd' — run 'cckit help'" >&2; exit 2 ;;
esac
