---
// TutorialMeta — the panel under a guide's title. Read entirely from the page's `tutorial:`
// frontmatter (via Starlight route data) so an author drops <TutorialMeta /> in with no props.
// Two stacked blocks, never side by side:
//   1. the prompt banner: a mark, one line, and the button that copies a prompt pointing the agent
//      at this guide,
//   2. "Before you start": the prerequisites as a checklist, with difficulty and read time as chips.
// A prerequisite is a string, or { text, link, href }: `link` is the words that become a link (found
// inside `text`, else appended after it); backticks in `text` become inline code.
// The copied prompt links the docs (agent contract, CLI reference, install) and this page's URL so
// the agent reads them and learns the cckit CLI; it never hardcodes issue numbers.
import { trackOf } from '../lib/tracks';

const route = Astro.locals.starlightRoute;
const data = route?.entry?.data ?? {};
const t = data.tutorial;

const es = route?.locale === 'es';
const marketing = trackOf(Astro.url.pathname) === 'marketing';
const who = marketing ? (es ? 'tu asistente' : 'your assistant') : 'your agent';

const diffLabel = es
  ? { beginner: 'Para empezar', intermediate: 'Intermedia', advanced: 'Avanzada' }
  : { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced' };
const S = es
  ? {
      aria: 'Sobre esta guía',
      before: 'Antes de empezar',
      agent: 'Deja que tu asistente lo haga',
      blurb: 'Copia el mensaje y pégalo en el chat.',
      button: 'Copiar el mensaje',
      copied: 'Copiado ✓',
      buttonAria: 'Copiar esta guía como mensaje para tu asistente',
    }
  : {
      aria: 'About this guide',
      before: 'Before you start',
      agent: marketing ? 'Let your assistant do it' : 'Let your agent do it',
      blurb: 'Copy the prompt and paste it in the chat.',
      button: 'Copy the prompt',
      copied: 'Copied ✓',
      buttonAria: `Copy this guide as a prompt for ${who}`,
    };

type Part = { kind: 'text' | 'code' | 'link'; value: string };
/** Split an item into text / inline-code / link parts. */
function parts(item: string | { text: string; link?: string; href?: string }): { parts: Part[]; href?: string } {
  const text = typeof item === 'string' ? item : item.text;
  const link = typeof item === 'string' ? undefined : item.link;
  const href = typeof item === 'string' ? undefined : item.href;
  const out: Part[] = text.split('`').map((value, i) => ({ kind: i % 2 ? 'code' : 'text', value }) as Part);
  if (link && href) {
    const at = out.findIndex((p) => p.kind === 'text' && p.value.includes(link));
    if (at >= 0) {
      const [before, after] = [out[at].value.slice(0, out[at].value.indexOf(link)), out[at].value.slice(out[at].value.indexOf(link) + link.length)];
      out.splice(at, 1, { kind: 'text', value: before }, { kind: 'link', value: link }, { kind: 'text', value: after });
    } else {
      out.push({ kind: 'text', value: ' ' }, { kind: 'link', value: link });
    }
  }
  return { parts: out.filter((p) => p.value !== ''), href };
}
const items = (t?.prerequisites ?? []).map(parts);

const DOCS = 'https://cckit.dev';
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? DOCS).href;

const copyMarkdown = t
  ? `I want to: ${t.job}.

Follow this cckit guide and do it in my repo, step by step:
${pageUrl}

cckit is a CLI that drives the whole GitHub work lifecycle from your coding agent's chat. If you
don't already know its commands, read these first, then follow the guide above:
- Agent contract (the command grammar): ${DOCS}/agents/
- CLI reference: ${DOCS}/cli-reference/
- Install cckit: ${DOCS}/getting-started/install/

Read the board with \`cckit sync\` before acting, use the exact commands from the guide, and run
them as we go — telling me what each one did.
`
  : '';
---
{t && (
  <aside class="tut" aria-label={S.aria}>
    <div class="tut-bar">
      <span class="tut-mark" aria-hidden="true">❯_</span>
      <p class="tut-bar-text"><strong>{S.agent}</strong><span>{S.blurb}</span></p>
      <button type="button" class="tut-copy" data-copy-md={copyMarkdown} data-copied-label={S.copied} aria-label={S.buttonAria}>
        <svg class="tut-copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span class="tut-copy-label">{S.button}</span>
      </button>
    </div>
    <section class="tut-card" aria-labelledby="tut-needs">
      <div class="tut-head">
        <h2 class="tut-h" id="tut-needs">{S.before}</h2>
        <span class="tut-chip">{diffLabel[t.difficulty] ?? t.difficulty}</span>
        <span class="tut-chip">{t.time}</span>
      </div>
      {items.length > 0 && (
        <ul class="tut-list">
          {items.map((it) => (
            <li>
              {it.parts.map((p) =>
                p.kind === 'code' ? <code>{p.value}</code>
                : p.kind === 'link' ? <a href={it.href}>{p.value}</a>
                : p.value,
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  </aside>
)}

<script is:inline>
  document.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-copy-md]');
    if (!btn) return;
    const md = btn.getAttribute('data-copy-md') || '';
    const label = btn.querySelector('.tut-copy-label');
    const done = () => {
      if (!label) return;
      const prev = label.textContent;
      label.textContent = btn.getAttribute('data-copied-label') || 'Copied ✓';
      btn.classList.add('is-copied');
      setTimeout(() => { label.textContent = prev; btn.classList.remove('is-copied'); }, 1600);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(md).then(done).catch(() => {});
    } else {
      const ta = document.createElement('textarea');
      ta.value = md; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); done(); } catch (e) {}
      document.body.removeChild(ta);
    }
  });
</script>

<style>
  .tut { margin: 0.5rem 0 2rem; display: grid; gap: 0.75rem; }
  /* Starlight's flow margin (`* + *`) would push the blocks apart unevenly. */
  .tut :global(:where(section, div, ul, li, h2, p, span, button)) { margin-top: 0; }
  .tut-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--cckit-prompt) 45%, var(--sl-color-hairline));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--cckit-prompt) 8%, var(--sl-color-bg));
  }
  .tut-mark { flex: none; font-family: var(--sl-font-mono); font-weight: 600; color: var(--cckit-prompt); }
  .tut-bar-text { flex: 1 1 14rem; min-width: 0; margin: 0; display: grid; line-height: 1.4; max-width: none; }
  .tut-bar-text strong { color: var(--sl-color-white); font-weight: 600; }
  .tut-bar-text span { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .tut-copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 0.95rem;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--cckit-prompt) 60%, transparent);
    color: var(--cckit-prompt);
    background: transparent;
  }
  .tut-copy:hover { background: color-mix(in srgb, var(--cckit-prompt) 14%, transparent); }
  .tut-copy.is-copied { border-color: var(--cckit-prompt); }
  .tut-copy:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  .tut-copy-icon { flex: none; }
  .tut-card {
    padding: 0.95rem 1.1rem 1.05rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 45%, transparent);
  }
  .tut-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 0.65rem; }
  .tut :global(h2.tut-h) {
    margin: 0 auto 0 0;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--sl-color-white);
  }
  .tut-chip {
    padding: 0.1rem 0.6rem;
    font-size: var(--sl-text-xs);
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
  }
  .tut-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; max-width: none; }
  .tut-list li {
    margin: 0;
    padding-inline-start: 1.75rem;
    position: relative;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  .tut-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.2rem;
    width: 1rem;
    height: 1rem;
    border: 1.5px solid var(--sl-color-gray-3);
    border-radius: 0.25rem;
  }
  .tut-list :global(li + li) { margin-top: 0; }
</style>
