---
// TutorialMeta — the header block under a tutorial's title. Read entirely from the page's `tutorial:`
// frontmatter (via Starlight route data) so an author drops <TutorialMeta /> in with no props:
//   1. a "prompt bar" (Clerk-quickstart style) with a Copy-as-Markdown button,
//   2. a "Before you start" card for cold traffic that may not know what cckit / Claude Code is,
//   3. a "This tutorial" card: difficulty · read-time · prerequisites.
// The two cards use Starlight's own <CardGrid>/<Card> so their layout, equal height, and content
// spacing come from the design system (no hand-rolled grid). The copied prompt links the docs
// (agent contract, CLI reference, install) and this page's URL so Claude reads them and learns the
// cckit CLI; it never hardcodes issue numbers.
import { Card, CardGrid } from '@astrojs/starlight/components';

const route = Astro.locals.starlightRoute;
const data = route?.entry?.data ?? {};
const t = data.tutorial;
const diffLabel = { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced' };

const DOCS = 'https://cckit.vercel.app';
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? DOCS).href;

const copyMarkdown = t
  ? `I want to: ${t.job}.

Follow this cckit tutorial and do it in my repo, step by step:
${pageUrl}

cckit is a CLI that drives the whole GitHub work lifecycle from Claude Code. If you don't already
know its commands, read these first, then follow the tutorial above:
- Agent contract (the command grammar): ${DOCS}/agents/
- CLI reference: ${DOCS}/cli-reference/
- Install cckit: ${DOCS}/install/

Read the board with \`cckit sync\` before acting, use the exact commands from the tutorial, and run
them as we go — telling me what each one did.
`
  : '';
---
{t && (
  <div class="tut-header">
    <div class="tut-promptbar">
      <div class="tut-promptbar-copy">
        <span class="tut-promptbar-mark" aria-hidden="true">❯_</span>
        <div class="tut-promptbar-text">
          <strong>Do this with Claude&nbsp;Code</strong>
          <span>Copy a prompt that links the cckit docs so Claude learns the CLI, then follows these steps.</span>
        </div>
      </div>
      <button type="button" class="tut-copy" data-copy-md={copyMarkdown} aria-label="Copy this tutorial as a Claude Code prompt">
        <svg class="tut-copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span class="tut-copy-label">Copy as Markdown</span>
      </button>
    </div>

    <CardGrid>
      <Card title="Before you start" icon="rocket">
        <div class="tut-links">
          <a href="/install/">Install cckit</a>
          <a href="/getting-started/">Quickstart: your first lifecycle</a>
        </div>
      </Card>
      <Card title="This tutorial" icon="open-book">
        <div class="tut-meta" data-difficulty={t.difficulty}>
          <span class="tut-badge tut-diff">{diffLabel[t.difficulty] ?? t.difficulty}</span>
          <span class="tut-badge tut-time">{t.time} read</span>
          {t.prerequisites.length > 0 && (
            <span class="tut-pre">
              <span class="tut-pre-label">Needs</span>
              {t.prerequisites.map((p) =>
                p === 'cckit installed and initialized' ? (
                  <span class="tut-chip tut-chip-link">cckit <a href="/install/">installed</a> &amp; <a href="/initialize/">initialized</a></span>
                ) : (
                  <code class="tut-chip">{p}</code>
                ),
              )}
            </span>
          )}
        </div>
      </Card>
    </CardGrid>
  </div>
)}

<script is:inline>
  document.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-copy-md]');
    if (!btn) return;
    const md = btn.getAttribute('data-copy-md') || '';
    const label = btn.querySelector('.tut-copy-label');
    const done = () => {
      if (!label) return;
      const prev = label.textContent;
      label.textContent = 'Copied ✓';
      btn.classList.add('is-copied');
      setTimeout(() => { label.textContent = prev; btn.classList.remove('is-copied'); }, 1600);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(md).then(done).catch(() => {});
    } else {
      const ta = document.createElement('textarea');
      ta.value = md; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); done(); } catch (e) {}
      document.body.removeChild(ta);
    }
  });
</script>

<style>
  .tut-header { display: flex; flex-direction: column; gap: 1rem; margin: 0.6rem 0 1.9rem; }

  /* Prompt bar — full-width call to action, styled off the Starlight accent. */
  .tut-promptbar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
    padding: 1rem 1.15rem;
    border-radius: 12px;
    border: 1px solid var(--sl-color-accent-low);
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--sl-color-accent-low) 55%, transparent), transparent 70%),
      var(--sl-color-bg-sidebar);
    overflow: hidden;
  }
  .tut-promptbar-copy { display: flex; align-items: center; gap: 0.85rem; min-width: 15rem; flex: 1 1 20rem; }
  .tut-promptbar-mark {
    font-family: var(--sl-font-mono); font-size: 1.35rem; line-height: 1;
    color: var(--sl-color-text-accent); opacity: 0.85; flex: none;
  }
  .tut-promptbar-text { display: flex; flex-direction: column; gap: 0.15rem; }
  .tut-promptbar-text strong { color: var(--sl-color-white); font-size: var(--sl-text-base); }
  .tut-promptbar-text span { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }

  .tut-copy {
    display: inline-flex; align-items: center; gap: 0.45rem; flex: none;
    font: inherit; font-size: var(--sl-text-sm); font-weight: 600; cursor: pointer;
    padding: 0.5rem 0.95rem; border-radius: 8px;
    border: 1px solid var(--sl-color-accent);
    color: var(--sl-color-text-invert); background: var(--sl-color-accent);
    transition: background 0.15s ease, filter 0.15s ease;
  }
  .tut-copy:hover { filter: brightness(1.08); }
  .tut-copy.is-copied { background: var(--sl-color-accent-high); border-color: var(--sl-color-accent-high); }
  .tut-copy-icon { flex: none; }

  /* Give both cards equal breathing room; the grid + equal height come from Starlight's CardGrid. */
  .tut-header :global(.card) { height: 100%; }
  .tut-links { display: flex; flex-direction: column; gap: 0.4rem; }
  .tut-links a { font-weight: 600; }

  .tut-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.7rem; font-size: var(--sl-text-sm); }
  .tut-badge {
    font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); letter-spacing: 0.04em;
    padding: 0.15rem 0.6rem; border-radius: 999px;
    border: 1px solid var(--sl-color-hairline); color: var(--sl-color-gray-2); white-space: nowrap;
  }
  .tut-diff { color: var(--sl-color-text-accent); border-color: var(--sl-color-accent-low); }
  .tut-meta[data-difficulty='advanced'] .tut-diff { color: #d9a441; border-color: #d9a44166; }
  .tut-pre { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .tut-pre-label {
    font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--sl-color-gray-3);
  }
  .tut-chip {
    font-size: var(--sl-text-xs); background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--sl-color-hairline); border-radius: 6px; padding: 0.05rem 0.45rem;
  }
  .tut-chip-link {
    display: inline-flex; align-items: center; gap: 0.28rem;
    font-family: var(--sl-font); color: var(--sl-color-gray-2); white-space: nowrap;
  }
  .tut-chip-link a { font-weight: 600; }
</style>
