---
// SearchStart — the search entry on the home page and on each track's entry page: a large field (a
// button styled as an input) and a row of "Try:" chips. Each chip is a real link to the page that
// answers it; a script upgrades the click to open search with the chip's text typed in, and lets the
// link navigate when search does not open. The chips are defined HERE, one list per track and language.
//   <SearchStart kind="home" />          the field + the first two chips of each track, with track dots
//   <SearchStart kind="software" />      /software/
//   <SearchStart kind="marketing" />     /marketing/
//   <SearchStart kind="marketing-es" />  /es/marketing/
interface Props {
  kind: 'home' | 'software' | 'marketing' | 'marketing-es';
}
const { kind } = Astro.props;

type Chip = { text: string; href: string; track?: 'software' | 'marketing' };

const SOFTWARE: Chip[] = [
  { text: 'How do I start my first task?', href: '/development/issue-to-merged-pr/' },
  { text: 'Add cckit to a project I already have', href: '/getting-started/existing-repo/' },
  { text: 'Run several tasks at once', href: '/development/waves/' },
  { text: 'What gets checked before a merge?', href: '/review/' },
  { text: 'Where are we, and what is left?', href: '/cli-reference/#where-are-we' },
];
const MARKETING: Chip[] = [
  { text: 'How do I ask for a new page?', href: '/marketing/your-first-piece/' },
  { text: 'How do I review and approve a piece?', href: '/marketing/review-and-approval/' },
  { text: 'Plan a campaign with several pieces', href: '/marketing/campaigns/' },
  { text: 'Teach it our brand voice', href: '/marketing/brand-voice/' },
  { text: 'What does this word mean?', href: '/marketing/words-you-will-hear/' },
];
const MARKETING_ES: Chip[] = [
  { text: '¿Cómo pido una página nueva?', href: '/es/marketing/your-first-piece/' },
  { text: '¿Cómo reviso y apruebo una pieza?', href: '/es/marketing/review-and-approval/' },
  { text: 'Planear una campaña con varias piezas', href: '/es/marketing/campaigns/' },
  { text: 'Enseñarle nuestra voz de marca', href: '/es/marketing/brand-voice/' },
  { text: '¿Qué significa esta palabra?', href: '/es/marketing/words-you-will-hear/' },
];

const chips: Chip[] =
  kind === 'home'
    ? [
        ...SOFTWARE.slice(0, 2).map((c) => ({ ...c, track: 'software' as const })),
        ...MARKETING.slice(0, 2).map((c) => ({ ...c, track: 'marketing' as const })),
      ]
    : kind === 'software'
      ? SOFTWARE
      : kind === 'marketing'
        ? MARKETING
        : MARKETING_ES;

const es = kind === 'marketing-es';
const field = es
  ? 'Busca o pregunta: ¿cómo reviso una pieza?'
  : kind === 'marketing'
    ? 'Search, or ask: how do I review a piece?'
    : 'Search, or ask: how do I start a task?';
const tryLabel = es ? 'Prueba:' : 'Try:';
---

<div class:list={['sstart', `sstart--${kind}`]}>
  <button type="button" class="sstart-field" data-search-start aria-label={field}>
    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
      <path
        d="M14.386 14.386l4.0877 4.0877-4.0877-4.0877c-2.9418 2.9419-7.7115 2.9419-10.6533 0-2.9419-2.9418-2.9419-7.7115 0-10.6533 2.9418-2.9419 7.7115-2.9419 10.6533 0 2.9419 2.9418 2.9419 7.7115 0 10.6533z"
        stroke="currentColor"
        fill="none"
        fill-rule="evenodd"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span>{field}</span>
  </button>
  <div class="sstart-row">
    <span class="sstart-try">{tryLabel}</span>
    <ul class="sstart-chips">
      {
        chips.map((c) => (
          <li>
            <a class="sstart-chip" href={c.href} data-search-query={c.text}>
              {c.track && <span class="sstart-dot" data-track={c.track} aria-hidden="true" />}
              {c.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  /** The visible search trigger of whichever search is installed: Algolia DocSearch, or Pagefind. */
  function trigger(): HTMLButtonElement | null {
    const b =
      document.querySelector<HTMLButtonElement>('.DocSearch-Button') ??
      document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
    return b && !b.disabled ? b : null;
  }
  /** The text input inside the open search modal, or null while there is none. */
  function modalInput(): HTMLInputElement | null {
    return (
      document.querySelector<HTMLInputElement>('.DocSearch-Input') ??
      document.querySelector<HTMLInputElement>('site-search dialog[open] input')
    );
  }
  /** Open search, wait up to ~400 ms for its input, and type the query in. Resolves to whether it worked. */
  function openSearch(query?: string): Promise<boolean> {
    const btn = trigger();
    if (!btn) return Promise.resolve(false);
    btn.click();
    return new Promise((resolve) => {
      const started = Date.now();
      const tick = () => {
        const input = modalInput();
        if (input) {
          if (query !== undefined) {
            const set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
            set?.call(input, query);
            input.dispatchEvent(new Event('input', { bubbles: true }));
          }
          input.focus();
          resolve(true);
        } else if (Date.now() - started > 400) {
          resolve(false);
        } else {
          setTimeout(tick, 40);
        }
      };
      tick();
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const field = target?.closest('[data-search-start]');
    if (field) {
      event.preventDefault();
      // Pagefind closes its modal on any click that reaches `window` from outside it, so stop here.
      event.stopPropagation();
      void openSearch();
      return;
    }
    const chip = target?.closest<HTMLAnchorElement>('a[data-search-query]');
    if (!chip) return;
    // A new-tab or download click is the reader asking for the page: leave it alone.
    const e = event as MouseEvent;
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    if (!trigger()) return; // no search on this page: the link navigates
    event.preventDefault();
    event.stopPropagation();
    void openSearch(chip.dataset.searchQuery).then((ok) => {
      if (!ok) location.href = chip.href;
    });
  });
</script>

<style>
  .sstart { margin: 1.5rem 0 2rem; }
  .sstart--home { max-width: 52rem; margin-inline: auto; }
  .sstart--home .sstart-field { margin-inline: auto; }
  .sstart-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 40rem;
    min-height: 3.5rem;
    padding: 0 1.1rem;
    font: inherit;
    font-size: 1.125rem;
    text-align: start;
    color: var(--sl-color-gray-3);
    background: var(--cckit-field-bg);
    border: 1px solid var(--cckit-field-border);
    border-radius: 0.75rem;
    cursor: pointer;
  }
  .sstart-field:hover { border-color: var(--sl-color-gray-3); color: var(--sl-color-gray-2); }
  .sstart-field:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  .sstart-field svg { flex: none; }
  .sstart-field span { min-width: 0; overflow-wrap: anywhere; }
  .sstart-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-top: 1rem;
  }
  .sstart-try { flex: none; font-size: 0.9375rem; color: var(--sl-color-gray-3); }
  .sstart-chips { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .sstart-chips :global(li) { margin: 0; }
  .sstart-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0 0.9rem;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    background: var(--cckit-field-bg);
    border: 1px solid var(--cckit-field-border);
    border-radius: 999px;
  }
  .sstart-chip:hover { color: var(--sl-color-white); border-color: var(--sl-color-accent); }
  .sstart-chip:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  .sstart-dot { width: 0.5rem; height: 0.5rem; flex: none; border-radius: 50%; }
  .sstart-dot[data-track='software'] { background: var(--cckit-track-software); }
  .sstart-dot[data-track='marketing'] { background: var(--cckit-track-marketing); }
  @media (max-width: 40rem) {
    .sstart-field { font-size: 1rem; min-height: 3.25rem; }
    .sstart-row { flex-direction: column; align-items: flex-start; }
  }
</style>
