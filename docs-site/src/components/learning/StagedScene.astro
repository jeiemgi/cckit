---
// StagedScene — one operation told as numbered steps. Each step has its text, the word it
// introduces, a limit to keep in mind, and a small table of where things stand after it.
//
// Without JavaScript every step is on the page, in order: that list is the static version.
// With JavaScript the scene shows one step at a time and adds controls: Previous, Next, Back to
// step 1, Play / Pause, and a switch back to the full list. Playing is opt-in, stops at the last
// step and on any other use of the controls, and is unavailable while the system asks for reduced
// motion. A step change is announced through a status line; focus stays on the control used.
//
//   import StagedScene from '../../../components/learning/StagedScene.astro';
//   import { smallChange } from '../../../components/learning/content';
//   <StagedScene scene={smallChange} />
//
// `scene` holds both languages; the language follows the page path (or the `lang` prop).
import { langOf, sceneUi, type Lang, type SceneContent } from './content';

interface Props {
  scene: Record<Lang, SceneContent>;
  lang?: Lang;
  /** Seconds each step stays up while playing. */
  seconds?: number;
}
const lang = Astro.props.lang ?? langOf(Astro.url.pathname);
const c = Astro.props.scene[lang];
const ui = sceneUi[lang];
const seconds = Astro.props.seconds ?? 8;
const total = c.steps.length;
const of = lang === 'es' ? 'de' : 'of';
---

<cckit-staged-scene
  class="ls not-content"
  data-seconds={seconds}
  data-status={ui.status}
  data-play={ui.play}
  data-pause={ui.pause}
  data-show-all={ui.showAll}
  data-show-one={ui.showOne}
>
  <section aria-label={c.label}>
    <p class="ls-example">{c.example}</p>

    <div class="ls-controls" role="group" aria-label={ui.controls} hidden>
      <button type="button" class="ls-prev">
        <span aria-hidden="true">←</span>
        {ui.previous}
      </button>
      <button type="button" class="ls-next">
        {ui.next}
        <span aria-hidden="true">→</span>
      </button>
      <button type="button" class="ls-replay">{ui.replay}</button>
      <button type="button" class="ls-play" aria-pressed="false">{ui.play}</button>
      <button type="button" class="ls-mode" aria-pressed="false">{ui.showAll}</button>
    </div>
    <p class="ls-motion" hidden>{ui.reducedMotion}</p>
    <p class="ls-status" role="status" hidden></p>

    <ol class="ls-steps">
      {
        c.steps.map((s, i) => (
          <li class="ls-step" data-title={s.title}>
            <div class="ls-text">
              <p class="ls-count">
                {ui.stepWord} {i + 1} {of} {total}
              </p>
              <h3 class="ls-title">{s.title}</h3>
              <p class="ls-body" set:html={s.body} />
              {s.term && (
                <div class="ls-term">
                  <p class="ls-label">{ui.termLabel}</p>
                  <p>
                    <strong>{s.term.word}.</strong> {s.term.definition}
                  </p>
                </div>
              )}
              {s.note && (
                <div class="ls-note">
                  <p class="ls-label">{ui.noteLabel}</p>
                  <p set:html={s.note} />
                </div>
              )}
            </div>
            <div class="ls-state">
              <p class="ls-label">{c.stateHeading}</p>
              <dl>
                {s.state.map((row, r) => (
                  <div class="ls-row" data-state={row.state}>
                    <dt>{c.tracks[r]}</dt>
                    <dd>
                      <span class="ls-mark" aria-hidden="true" />
                      <span class="ls-value">{row.value}</span>
                      {(row.state === 'new' || row.state === 'changed') && (
                        <span class="ls-badge">{ui.stateWords[row.state]}</span>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="ls-caption">{c.illustration}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</cckit-staged-scene>

<script>
  class CckitStagedScene extends HTMLElement {
    connectedCallback() {
      const q = <T extends HTMLElement>(sel: string) => this.querySelector<T>(sel);
      const steps = [...this.querySelectorAll<HTMLElement>('.ls-step')];
      const controls = q('.ls-controls');
      const status = q('.ls-status');
      const motionNote = q('.ls-motion');
      const prev = q<HTMLButtonElement>('.ls-prev');
      const next = q<HTMLButtonElement>('.ls-next');
      const replay = q<HTMLButtonElement>('.ls-replay');
      const play = q<HTMLButtonElement>('.ls-play');
      const mode = q<HTMLButtonElement>('.ls-mode');
      if (!controls || !status || !motionNote || !prev || !next || !replay || !play || !mode || steps.length === 0) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const ms = Math.max(3, Number(this.dataset.seconds) || 8) * 1000;
      let index = 0;
      let showAll = false;
      let timer: number | undefined;

      // aria-disabled, not `disabled`: a disabled button drops keyboard focus when it was the one
      // just pressed (Previous on reaching step 1, Next on reaching the last step).
      const setOff = (button: HTMLButtonElement, off: boolean) => button.setAttribute('aria-disabled', String(off));
      const isOff = (button: HTMLButtonElement) => button.getAttribute('aria-disabled') === 'true';

      const stop = () => {
        if (timer !== undefined) window.clearInterval(timer);
        timer = undefined;
        play.setAttribute('aria-pressed', 'false');
        play.textContent = this.dataset.play ?? '';
      };

      const render = (announce: boolean) => {
        steps.forEach((step, i) => {
          step.hidden = !showAll && i !== index;
        });
        const last = index === steps.length - 1;
        setOff(prev, showAll || index === 0);
        setOff(next, showAll || last);
        setOff(replay, showAll || index === 0);
        setOff(play, showAll || reduce.matches);
        motionNote.hidden = !reduce.matches;
        mode.setAttribute('aria-pressed', String(showAll));
        mode.textContent = (showAll ? this.dataset.showOne : this.dataset.showAll) ?? '';
        this.toggleAttribute('data-all', showAll);
        const text = showAll
          ? ''
          : (this.dataset.status ?? '')
              .replace('{n}', String(index + 1))
              .replace('{total}', String(steps.length))
              .replace('{title}', steps[index].dataset.title ?? '');
        // The status line is for assistive technology; the visible step count is inside each step.
        if (announce) status.textContent = text;
      };

      const go = (to: number, announce = true) => {
        index = Math.min(steps.length - 1, Math.max(0, to));
        render(announce);
      };

      prev.addEventListener('click', () => {
        stop();
        if (!isOff(prev)) go(index - 1);
      });
      next.addEventListener('click', () => {
        stop();
        if (!isOff(next)) go(index + 1);
      });
      replay.addEventListener('click', () => {
        stop();
        if (!isOff(replay)) go(0);
      });
      mode.addEventListener('click', () => {
        stop();
        showAll = !showAll;
        render(true);
      });
      play.addEventListener('click', () => {
        if (timer !== undefined) return stop();
        if (isOff(play)) return;
        if (index === steps.length - 1) go(0);
        play.setAttribute('aria-pressed', 'true');
        play.textContent = this.dataset.pause ?? '';
        timer = window.setInterval(() => {
          go(index + 1);
          if (index === steps.length - 1) stop();
        }, ms);
      });
      // Reading the scene by hand ends automatic play: a key pressed or a pointer used inside a
      // step, or the page going to the background.
      this.querySelector('.ls-steps')?.addEventListener('pointerdown', stop);
      this.querySelector('.ls-steps')?.addEventListener('keydown', stop);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
      });
      reduce.addEventListener('change', () => {
        if (reduce.matches) stop();
        render(false);
      });

      this.setAttribute('data-enhanced', '');
      controls.hidden = false;
      status.hidden = false;
      render(false);
    }
  }
  if (!customElements.get('cckit-staged-scene')) customElements.define('cckit-staged-scene', CckitStagedScene);
</script>

<style>
  /* Text, surfaces and the action colour come from the site theme (src/styles/theme.css). The two
     marker colours are brand colours from docs/design/512/README.md (cobalt and ochre), adjusted per
     theme to reach 3:1 against the panel; each marker also has a written label beside it. */
  .ls {
    --ls-surface: var(--sl-color-gray-6);
    --ls-panel: var(--sl-color-bg);
    --ls-edge: var(--sl-color-gray-5);
    --ls-new: #6f93ee;
    --ls-changed: #d4af59;
    display: block;
    margin-block: 1.5rem;
    color: var(--sl-color-text);
    font-size: 1rem;
    line-height: 1.55;
  }
  :global([data-theme='light']) .ls {
    --ls-surface: #ffffff;
    --ls-panel: var(--sl-color-black);
    --ls-new: #2457d6;
    --ls-changed: #8a6a12;
  }
  .ls p,
  .ls h3,
  .ls dl,
  .ls dd {
    margin: 0;
  }
  .ls [hidden] {
    display: none !important;
  }
  .ls-example {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .ls-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }
  .ls button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font: inherit;
    font-size: 0.9375rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    color: var(--sl-color-white);
    background: var(--cckit-field-bg, transparent);
    border: 1px solid var(--cckit-field-border, currentColor);
    border-radius: 0.375rem;
    cursor: pointer;
  }
  .ls button:hover {
    border-color: var(--sl-color-white);
  }
  .ls button:focus-visible {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .ls .ls-next {
    color: var(--sl-color-text-invert);
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }
  .ls button[aria-pressed='true'] {
    border-color: var(--sl-color-white);
    box-shadow: inset 0 0 0 1px var(--sl-color-white);
  }
  /* Unavailable: dashed edge and muted text, so the state does not depend on colour alone. */
  .ls button[aria-disabled='true'] {
    color: var(--sl-color-gray-3);
    background: transparent;
    border-style: dashed;
    border-color: var(--sl-color-gray-4);
    cursor: not-allowed;
  }
  .ls-motion {
    margin-top: 0.5rem !important;
    color: var(--sl-color-gray-3);
    font-size: 0.9375rem;
  }
  /* The step count is visible inside each step; this line repeats it for a screen reader. */
  .ls-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ls-steps {
    list-style: none;
    margin: 0.875rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.875rem;
  }
  .ls-step {
    display: grid;
    gap: 1rem 1.25rem;
    padding: 1rem;
    background: var(--ls-surface);
    border: 1px solid var(--ls-edge);
    border-radius: 0.5rem;
  }
  /* Text beside the state panel when the scene itself is wide enough; stacked otherwise. */
  .ls {
    container-type: inline-size;
  }
  @container (min-width: 36rem) {
    .ls-step {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .ls-text {
    display: grid;
    gap: 0.625rem;
    align-content: start;
  }
  .ls-count,
  .ls-label {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ls-title {
    color: var(--sl-color-white);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .ls-term,
  .ls-note {
    padding-inline-start: 0.75rem;
    border-inline-start: 3px solid var(--ls-edge);
  }
  .ls-term {
    border-inline-start-color: var(--ls-new);
  }
  .ls-term strong,
  .ls-body :global(strong) {
    color: var(--sl-color-white);
  }

  .ls-state {
    padding: 0.875rem;
    background: var(--ls-panel);
    border: 1px solid var(--ls-edge);
    border-radius: 0.375rem;
  }
  .ls-state dl {
    display: grid;
    gap: 0.625rem;
    margin-top: 0.625rem;
  }
  .ls-row dt {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  /* Marker, then the value; the badge sits under the value so a long value never strands the marker. */
  .ls-row dd {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.25rem 0.5rem;
    color: var(--sl-color-white);
  }
  .ls-badge {
    grid-column: 2;
    justify-self: start;
  }
  .ls-mark {
    margin-top: 0.4em;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--sl-color-gray-3);
    border-radius: 50%;
  }
  .ls-row[data-state='kept'] .ls-mark {
    background: var(--sl-color-gray-3);
  }
  .ls-row[data-state='new'] .ls-mark {
    background: var(--ls-new);
    border-color: var(--ls-new);
  }
  .ls-row[data-state='changed'] .ls-mark {
    border-color: var(--ls-changed);
    border-radius: 2px;
  }
  .ls-row[data-state='none'] dd {
    color: var(--sl-color-gray-3);
  }
  .ls-badge {
    padding: 0 0.4375rem;
    color: var(--sl-color-white);
    font-size: 0.875rem;
    border: 1px solid var(--ls-new);
    border-radius: 999px;
  }
  .ls-row[data-state='changed'] .ls-badge {
    border-color: var(--ls-changed);
  }
  .ls-caption {
    margin-top: 0.75rem !important;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  .ls :global(code) {
    padding: 0.0625rem 0.3125rem;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.9em;
    color: var(--sl-color-white);
    background: var(--ls-panel);
    border: 1px solid var(--ls-edge);
    border-radius: 0.25rem;
    overflow-wrap: anywhere;
  }

  /* One step at a time: a short fade on the step that appears, only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    .ls[data-enhanced]:not([data-all]) .ls-step:not([hidden]) {
      animation: ls-in 0.24s ease-out;
    }
  }
  @keyframes ls-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
