---
// Header override. A three-column grid on a desktop: the logo, the search (centred on the page, up
// to 34rem), then the right group: version text, GitHub icon, language picker (only on a page that
// exists in both languages) and theme picker.
// On a phone: logo, spacer, search icon, then Starlight's menu button (which lives outside this
// component); version, GitHub, theme and language sit in the mobile menu footer.
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

// Render the search only when Pagefind or a Search override (DocSearch) is on, as Starlight does.
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="search-wrapper sl-flex print:hidden" data-header-search>
    {shouldRenderSearch && <Search />}
  </div>
  <div class="right-group sl-flex print:hidden">
    <div class="header-extras sl-hidden md:sl-flex">
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <LanguageSelect />
      <ThemeSelect />
    </div>
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      height: 100%;
    }
    .title-wrapper {
      /* Long titles must not cover the search and menu buttons on narrow screens. */
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      margin-inline-end: auto;
    }
    .right-group {
      gap: 0.75rem;
      align-items: center;
      order: 1;
    }
    .header-extras {
      gap: 1rem;
      align-items: center;
    }
    .social-icons {
      gap: 0.75rem;
      align-items: center;
    }
    .search-wrapper {
      order: 2;
    }
    @media (min-width: 50rem) {
      .header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 34rem) minmax(0, 1fr);
        gap: 1rem;
        align-content: center;
      }
      .title-wrapper {
        margin-inline-end: 0;
      }
      .search-wrapper {
        order: 0;
        justify-content: center;
        min-width: 0;
      }
      .right-group {
        order: 0;
        gap: 1rem;
        justify-self: end;
        min-width: 0;
      }
    }
  }
</style>
