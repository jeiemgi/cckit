---
// LanguageSelect override — the language picker shows only on a page that exists in both
// languages (src/lib/translated.mjs). Anywhere else it would lead to an English fallback copy.
import Default from '@astrojs/starlight/components/LanguageSelect.astro';
import { isTranslated } from '../lib/translated.mjs';

const show = isTranslated(Astro.url.pathname);
---

{show && <Default><slot /></Default>}
