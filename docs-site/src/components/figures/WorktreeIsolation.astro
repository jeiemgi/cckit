---
// Why parallel work does not collide: each issue gets its own branch + worktree; only the merged
// pull requests meet again on main.
// Static SVG, no client JavaScript. Colours come from the .cckit-figure rules in
// src/styles/theme.css, so the figure follows the light and dark themes.
---
<figure class="cckit-figure not-content">
  <svg viewBox="0 0 576 266" style="max-width: 576px" role="img" aria-labelledby="worktree-isolation-title">
    <title id="worktree-isolation-title">One repository fans out to three worktrees, one branch and issue each, which merge back into main without clashes.</title>
    <defs>
      <marker id="worktree-isolation-arrow-none" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrow" d="M0,0 L10,5 L0,10 z" /></marker>
    </defs>
    <path class="edge" d="M172,133 C190,133 190,43 208,43" marker-end="url(#worktree-isolation-arrow-none)" />
    <path class="edge" d="M172,133 C190,133 190,133 208,133" marker-end="url(#worktree-isolation-arrow-none)" />
    <path class="edge" d="M172,133 C190,133 190,223 208,223" marker-end="url(#worktree-isolation-arrow-none)" />
    <path class="edge" d="M368,43 C386,43 386,133 404,133" marker-end="url(#worktree-isolation-arrow-none)" />
    <path class="edge" d="M368,133 C386,133 386,133 404,133" marker-end="url(#worktree-isolation-arrow-none)" />
    <path class="edge" d="M368,223 C386,223 386,133 404,133" marker-end="url(#worktree-isolation-arrow-none)" />
    <g class="node k-neutral"><rect x="12" y="102" width="160" height="62" rx="10" /><text x="92" y="125" class="t">Repo</text><text x="92" y="146" class="d">main</text></g>
    <g class="node k-neutral"><rect x="208" y="12" width="160" height="62" rx="10" /><text x="288" y="35" class="t">Worktree A</text><text x="288" y="56" class="d">branch · issue #1</text></g>
    <g class="node k-neutral"><rect x="208" y="102" width="160" height="62" rx="10" /><text x="288" y="125" class="t">Worktree B</text><text x="288" y="146" class="d">branch · issue #2</text></g>
    <g class="node k-neutral"><rect x="208" y="192" width="160" height="62" rx="10" /><text x="288" y="215" class="t">Worktree C</text><text x="288" y="236" class="d">branch · issue #3</text></g>
    <g class="node k-accent"><rect x="404" y="102" width="160" height="62" rx="10" /><text x="484" y="125" class="t">Main</text><text x="484" y="146" class="d">merges, no clashes</text></g>
  </svg>
</figure>
