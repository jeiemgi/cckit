---
// Instagram / Stories card templates — one page per tutorial rendering a pixel-exact 1080×1080 feed
// card and a 1080×1920 story card. Instagram doesn't unfurl OG tags, so these are standalone graphics
// you export to PNG and post manually. Same visual language as the 1200×630 link cards
// (src/pages/og/[...slug].ts). Export by screenshotting each [data-card] region — e.g. with cckit's
// own browser bridge: `cckit debug` against the dev server, or any element-screenshot tool.
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries
    .filter((e) => e.id.startsWith('tutorials/') && e.data.tutorial)
    .map((e) => ({
      params: { slug: e.id.replace(/^tutorials\//, '') },
      props: { data: e.data },
    }));
}

const { data } = Astro.props;
const t = data.tutorial;
const eyebrow = ['Tutorial', t.ogTag, `${t.difficulty} · ${t.time}`].filter(Boolean).join('  ·  ');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{data.title} — social cards</title>
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: #1b1f24;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        color: #c3ced4;
        display: flex; flex-direction: column; align-items: center; gap: 28px;
        padding: 40px 20px 80px;
      }
      .hint {
        max-width: 1080px; width: 100%; font-size: 14px; line-height: 1.6; color: #8195a0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        border-left: 2px solid #2ab3a6; padding: 10px 0 10px 14px;
      }
      .hint b { color: #e9edef; }
      .label { align-self: flex-start; max-width: 1080px; width: 100%;
        font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 13px;
        letter-spacing: .12em; text-transform: uppercase; color: #5d6f7a; }

      /* Shared card surface — matches the OG link card. */
      .card {
        position: relative; overflow: hidden; color: #eef3f4;
        background:
          radial-gradient(120% 90% at 88% -20%, rgba(42,179,166,.30), transparent 55%),
          linear-gradient(160deg, #0c1218, #0b0f14 60%);
        border-left: 14px solid #2ab3a6;
        display: flex; flex-direction: column; justify-content: space-between;
      }
      .card::after {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background-image:
          linear-gradient(rgba(42,179,166,.08) 1px, transparent 1px),
          linear-gradient(90deg, rgba(42,179,166,.08) 1px, transparent 1px);
        background-size: 60px 60px; opacity: .5;
        -webkit-mask-image: linear-gradient(180deg, transparent, #000 40%, transparent);
                mask-image: linear-gradient(180deg, transparent, #000 40%, transparent);
      }
      .ey { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 18px;
        font-family: ui-monospace, "SF Mono", Menlo, monospace; letter-spacing: .28em;
        text-transform: uppercase; color: #2ab3a6; }
      .ey .sq { width: 20px; height: 20px; background: #46c46a; border-radius: 3px;
        box-shadow: 0 0 0 9px rgba(70,196,106,.18); }
      .title { position: relative; z-index: 1; font-weight: 800; letter-spacing: -0.03em;
        line-height: 1.03; color: #f3f8f8; text-wrap: balance; }
      .brand { position: relative; z-index: 1; display: flex; align-items: center;
        justify-content: space-between; font-family: ui-monospace, "SF Mono", Menlo, monospace; }
      .brand .name { color: #eef3f4; font-weight: 700; display: flex; align-items: center; gap: 14px; }
      .brand .name .p { color: #46c46a; }
      .brand .url { color: #8fa6ad; }

      /* Feed 1080×1080 */
      .square { width: 1080px; height: 1080px; padding: 96px 92px; }
      .square .ey { font-size: 30px; }
      .square .title { font-size: 92px; max-width: 92%; }
      .square .brand { font-size: 34px; }

      /* Story 1080×1920 — content weighted to the safe centre band. */
      .story { width: 1080px; height: 1920px; padding: 240px 96px; }
      .story .ey { font-size: 34px; }
      .story .title { font-size: 104px; }
      .story .brand { font-size: 36px; }
    </style>
  </head>
  <body>
    <p class="hint">
      <b>Instagram &amp; Stories graphics</b> for this tutorial. Instagram doesn't read OG tags, so
      export each card below to PNG and post it manually. Screenshot the <code>[data-card]</code>
      region at 1× — e.g. <code>cckit debug</code> against the dev server, or your browser's
      element-capture. The 1200×630 link card (LinkedIn / X / Facebook) is generated automatically at
      <code>/og/tutorials/{Astro.params.slug}.png</code>.
    </p>

    <div class="label">Instagram feed · 1080 × 1080</div>
    <div class="card square" data-card="square">
      <div class="ey"><span class="sq"></span>{eyebrow}</div>
      <div class="title">{data.title.replace(/^How to /, '')}</div>
      <div class="brand"><span class="name"><span class="p">❯</span> cckit</span><span class="url">cckit.vercel.app</span></div>
    </div>

    <div class="label">Instagram story · 1080 × 1920</div>
    <div class="card story" data-card="story">
      <div class="ey"><span class="sq"></span>{eyebrow}</div>
      <div class="title">{data.title.replace(/^How to /, '')}</div>
      <div class="brand"><span class="name"><span class="p">❯</span> cckit</span><span class="url">cckit.vercel.app/tutorials</span></div>
    </div>
  </body>
</html>
